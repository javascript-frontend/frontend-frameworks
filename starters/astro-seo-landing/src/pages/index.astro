---
const title = "Fast Zero-JS SEO Landing Page";
const description = "Semantic HTML landing page built with Astro 7 Islands Architecture.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body style="max-width: 760px; margin: 4rem auto; font-family: system-ui, sans-serif; padding: 0 1rem">
    <main>
      <h1>{title}</h1>
      <p>{description} Ships 0 KB of client JavaScript by default.</p>
    </main>
  </body>
</html>
